                                   % the indentation from the left margin for the Parameters and Returns
                                   % headings, which are generated by Doxygen.
    \setlength{\parsep}{0pt}%
    \setlength{\itemsep}{-4pt}%
    \renewcommand{\makelabel}{\entrylabel}%
  }%
  \item[#1]%
}{%
