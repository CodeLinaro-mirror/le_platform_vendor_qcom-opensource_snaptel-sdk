% 06/21/11. LB added the below code to format the Deprecated List chapter per new rqmts.
\newsavebox{\xrefbox}
\newlength{\xreflength}
\newcommand{\xreflabel}[1]{%
  \sbox{\xrefbox}{#1}%
  \setlength{\xreflength}{\wd\xrefbox}%
  \ifthenelse{\xreflength>\labelwidth}{%
    \begin{minipage}{\textwidth}%
      \vspace{0.1in} % Added to increase the space between each deprecated list
                     % item.
      \setlength{\parindent}{0pt}%
      \hangindent=10pt\bfseries #1\vspace{0.1in} % Default setting was \hangindent=15pt.
                                                 % Default setting was \vspace{1.2\itemsep},
                                                 % Replaced with \vspace{0.1in} to adjust
                                                 % space before the brief description.
    \end{minipage}%
  }{%
   \parbox[b]{\labelwidth}{\makebox[0pt][l]{\textbf{#1}}}%
  }}%



