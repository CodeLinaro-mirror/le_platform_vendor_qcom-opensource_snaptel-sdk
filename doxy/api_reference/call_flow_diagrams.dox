  \centering
  \includegraphics[scale=0.22]{data_lan2wan_vlan_config_from_eap.png}
  \renewcommand{\thefigure}{\thechapter-\arabic{figure}}
  \caption{LAN-WAN VLAN Configuration Usecase from EAP call flow}
