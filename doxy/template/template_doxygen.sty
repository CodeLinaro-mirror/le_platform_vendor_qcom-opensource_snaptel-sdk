% Used by @par and @paragraph. 09/07/11, LB, JG, & LG made changes to adjust various spacing rqmts, 
% especially needed to support using @par as part of Doxygen alias definitions for customized 
% unnumbered headings such as "Dependencies", "Description", "Side effects".
% 11/08/13 JG Redefined DoxyEnumerate and DoxyItemize environment settings when inside DoxyParagraph
\newenvironment{DoxyParagraph}[1]{%

	% Override global definition for numbered list
	\renewenvironment{DoxyEnumerate}{%
        \vspace{5pt} % 11/08/13 SW. Added to fine tune spacing; @par not needed before list.
		\enumerate%
  \setlength{\itemsep}{2pt}% Extra inter-item spacing added to \parsep.
  \setlength{\parsep}{3pt} % Paragraph separation within a single item
  \setlength{\topsep}{0pt} % Extra space added to \parskip before the first and after the last item
  \setlength{\partopsep}{0pt} %Added to the top and/or bottom of the list if and only if there's a blank line above or below the first or last item. Leave this alone unless blank lines become a problem.
  \setlength{\parskip}{3pt}	% Space between paragraphs outside of a list, and part of the space between a non-list paragraph and a list item.
	}{%
		\endenumerate%
	}

	% Override global definition for bulleted list
	\renewenvironment{DoxyItemize}{%
        \vspace{5pt} % 11/08/13 SW. Added to fine tune spacing; @par not needed before list.
		\begin{itemize}%
		\setlength{\itemsep}{2pt}
		\setlength{\parsep}{3pt} 
		\setlength{\topsep}{0pt}
		\setlength{\partopsep}{0pt}
		\setlength{\parskip}{3pt}	
	}{%
		\end{itemize}%
	}
  \begin{list}{}% 
  {%
    \settowidth{\topsep}{9pt}% Rubber space between first item and preceding paragraph. Space is not 
    % included if heading begins at top of page. This amount of space is added at the beginning of the 
    % environmment and at the end.
    \settowidth{\labelwidth}{40pt}% Width alloted for the label to be more than the longest label.
    \setlength{\leftmargin}{21.5pt}% Distance from the left margin to the heading.
    \setlength{\parsep}{0pt}% Rubber space between items if more than one item is included. Works with \itemsep.
    \setlength{\itemsep}{-4pt}% Extra inter-item spacing added to \parsep.
    \renewcommand{\makelabel}{\entrylabelpar}% Formats the label (unnumbered heading) and controls space between 
                                             % paragraphs inside the list.
  }%
    \ifthenelse{\equal{#1}{}}{\item[#1]\vspace{-18pt}}{\item[#1]}% If item (heading) is included, use standard 
                                                                 % spacing, if item (heading) is not included, 
                                                                 % adjust spacing accordingly.
}{%
  \end{list}%
}

