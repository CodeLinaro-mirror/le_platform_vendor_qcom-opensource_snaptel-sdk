    \vspace{\cftbeforetoctitleskip}
  \fi
  \@cftpagestyle
  {\interlinepenalty\@M
  {\cfttoctitlefont\contentsname}{\cftaftertoctitle}
	\color{blue} \rule{6.5in}{.018in}\\
  \cftmarktoc
  \par\nobreak
  \vskip \cftaftertoctitleskip
  \@afterheading}}
\makeatother
