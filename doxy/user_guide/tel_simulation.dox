@trfirsthdgend
@trhdg
@thdg{1,|c|,AppId} @thdg{1,c|,AppType} @thdg{1,c|,Transparent EFs} @thdglast{1,c|,Linear Fixed EFs}
@trhdgend

@tr @td a0000000871004f310ffff89080000ff @tdend @td ISIM  @tdend @td File Id 1234, 5648 @tdend @tdlast File Id 1234 , No of records 3 @tdlastend @trend
@tr @td a000000063504b43532d3135 @tdend @td Unknown  @tdend @td No files present @tdend @tdlast File Id 1234 , No of records 3 @tdlastend @trend
@tr @td a0000000871002fffff00189000001ff @tdend @td USIM  @tdend @td File Id 1234, 5648, 7777 @tdend @tdlast File Id 1234 , No of records 3 File Id 5678 , No of records 1 File Id 7676 , No of records 4 @tdlastend @trend
@tableend

<h3>DF files</h1>
@table{2,{\raggedright}p{2.00in},{\raggedright}p{2.00in}}
@trfirsthdg
@thmultcol{1,|c|} Transparent EFs @thmultcolend @thmultcol{1,c|} Linear Fixed EFs @thmultcollastend
@trfirsthdgend
