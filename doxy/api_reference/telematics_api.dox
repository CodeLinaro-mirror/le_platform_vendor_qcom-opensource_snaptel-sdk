/**
@defgroup chapter_telematics_sdk Telematics SDK API
@latexonly \setcounter{table}{0} @endlatexonly

  @addtogroup chapter_telematics_sdk
  @{
    @defgroup telematics_phone_factory  Phone Factory
    This section contains APIs related to PhoneFactory.
    @defgroup telematics_phone  Phone API
    This section contains APIs related to Phone, Signal Strength and interfaces to register global listeners to event notifications.
    @defgroup telematics_call  Call API
    This section contains APIs related to Call.
    @defgroup telematics_sms SMS API
    This section contains APIs related to Sending and Receiving SMS.
    @defgroup telematics_card Card API
    This section contains APIs related to Card Services.
    @defgroup telematics_location Location Services API
    This section contains APIs related to Location Services.
    @defgroup telematics_data Data Services API
    This section contains APIs related to Cellular Data Services.
    @defgroup telematics_subscription Subscription API
    This section contains APIs related to Subscription.
    @defgroup telematics_common Common
    This section contains APIs related to Command Callbacks, Error Codes and TelSdk Version information.
  @}
*/
