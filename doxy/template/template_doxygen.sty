                                  % heading always stays with the text that follows.
  \begin{list}{}%
  {%
    \setlength{\topsep}{4pt}  % 08/23/11. LB added to increase space above the heading label (e.g.,
                              % Parameters, Returns)
    \settowidth{\labelwidth}{40pt}%
