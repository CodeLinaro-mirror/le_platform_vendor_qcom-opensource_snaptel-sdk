{
    "json_update": {
        "modify":[
            "telsdk_event_injector -f json_update -e modify <path> <subsystem> <api> <attribute> <val>",
            "path:        path of the JSON to be updated.",
            "subsystem:   subsystem for which API behavior needs to be modified.",
            "api:         api for which a particular attribute has to be updated.",
            "attribute:   attribute to be updated.",
            "val:         value to be set."
        ]
    },
    "tel_sub": {
        "subscriptionInfo":[
            "telsdk_event_injector -f tel_sub -e subscriptionInfoChanged <slotId> <carrierName> <phoneNumber> <iccId> <mcc> <mnc> <imsi> <gid1> <gid2>\n",
            "slotId:      valid slot_ids are 1 & 2 only.",
            "carrierName:  valid carrierName.",
            "phoneNumber:  valid phoneNumber.",
            "iccId:        valid iccId",
            "mcc:          valid mcc",
            "mnc:          valid mnc",
            "imsi:         valid imsi",
            "gid1:         valid gid1",
            "gid2:         valid gid2"
        ]
    },
    "tel_card": {
        "cardInfo":[
            "telsdk_event_injector -f tel_card -e cardInfoChanged <slotId> <cardPower>\n",
            "slotId:       valid slotIds are 1 & 2 only.",
            "cardPower:    valid 1-Power ON, 0-Power OFF."
        ]
    },
    "tel_sms": {
        "memoryfull":[
            "telsdk_event_injector -f tel_sms -e memoryfull <slotId> <storageType>",
            "slotId:       valid slotIds are 1 & 2 only.",
            "storageType:  valid storage types are NONE , SIM"
        ],
        "incomingsms":[
            "telsdk_event_injector -f tel_sms -e incomingsms <slotId> <numberOfSegments> <refNumber> <segmentNumber> <encoding> <isMetaInfoValid> <pdu> <sender> <text>",
            "slotId:           valid slotIds are 1 & 2 only",
            "numberOfSegments: valid number of segments",
            "refNumber:        valid refNumber",
            "segmentNumber:    valid segmentNumber",
            "encoding:         valid encoding",
            "isMetaInfoValid:  valid isMetaInfoValid",
            "pdu:              valid pdu",
            "sender:           valid sender",
            "text:             valid text"
        ]
    },
    "loc_config":{
        "xtra_status":[
            "telsdk_event_injector -f loc_config -e xtra_status <validity> <dataStatus>",
            "validity         Number of hours that xtra assistance data will remain valid",
            "dataStatus       Valid status correspond to enum values of telux::loc::XtraDataStatus, eg: 1,2,3."
        ],
        "constellation_update":[
            "telsdk_event_injector -f loc_config -e constellation_update <mask>",
            "mask             A mask to enable different signals. Refer to telux::loc::GnssSignalType for the signals that can be enabled. An example of a valid mask is 0x1FFFFF."
        ]
    },
    "loc_mgr":{
        "capabilities_update":[
            "telsdk_event_injector -f loc_mgr -e capabilities_update <action> <mask>",
            "action: valid values - add/remove. Event to be used to add or remove capabilities that are indicated via @refILocationListener::onCapabilitiesInfo",
            "mask: Integer mask for different capabilities. Refer to telux::loc::LocCapabilityType for the capabilities that can be added/removed."
        ],
        "sysinfo_update_current":[
            "telsdk_event_injector -f loc_mgr -e sysinfo_update_current <current seconds> ",
            "current: Current leap seconds, in unit of seconds"
        ],
        "sysinfo_update_leapsecond" :[
            "telsdk_event_injector -f loc_mgr -e sysinfo_update_leapsecond <system_week> <system_msec> <leap_seconds_before_change> <leap_seconds_after_change>",
            "system_week:                    Extended week number at reference tick",
            "system_msec:                    Time into the current week at reference tick",
            "leap_seconds_before_change:     Number of leap seconds prior to the leap second change event",
            "leap_seconds_after_change:      Number of leap seconds after the leap second change event"
        ]
    },
    "sensor_feature": {
        "sensor_event":[
            "telsdk_event_injector -f sensor_feature -e sensor_event <featureName> <eventId>",
            "featureName       string, Valid features are available from JSON configuration.",
            "eventId           Integer, valid event Id are available from csv data file"
        ]
    },
    "tel_call": {
        "msdUpdateRequest":[
            "telsdk_event_injector -f tel_call -e msdUpdateRequest <slotId>",
            "slotId:       valid slotIds are 1 & 2 only."
        ],
        "incomingCall":[
            "telsdk_event_injector -f tel_call -e incomingCall <slotId> <phonenumber>",
            "slotId:           valid slotIds are 1 & 2 only.",
            "phonenumber:      valid phonenumber "
        ],
        "hangupCall":[
            "telsdk_event_injector -f tel_call -e hangupCall <slotId> <callId>",
            "slotId:           valid slotIds are 1 & 2 only." ,
            "callId:           valid callId"
        ]
    },
    "audio": {
        "ssr":[
            "telsdk_event_injector -f audio -e ssr <serviceStatus>",
            "serviceStatus:  valid service status are SERVICE_AVAILABLE, SERVICE_UNAVAILABLE & SERVICE_FAILED."
        ],
        "dtmf_detection":[
            "telsdk_event_injector -f audio -e dtmf_detection <lowFreq> <highFreq>",
            "lowFreq: valid lowFreqs are 697, 770, 852 & 941 only.",
            "highFreq: valid highFreqs are 1209, 1336, 1477 & 1633 only"
        ]
    }
}
