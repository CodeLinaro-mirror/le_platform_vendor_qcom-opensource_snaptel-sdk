% New command for annonymous enums. This was added to replace the anonymous enum heading generated by Doxygen, which is removed 
% in the post processing script (latexpostprocessing.py).
\newcommand{\anonenum}[2]{%
    \hypertarget{#2}{\subsubsection[{#1}]{\setlength{\rightskip}{0pt plus 5cm}enum {\bf #1}}}\label{#2}%
}

%LB 08/23/11. New location for defining the new \entrylabel command. Must be defined prior to use in
%DoxyDesc, DoxyFields, DoxyParamDesc, and Desc enviroments. The \entrylabel command formats the unnumbered 
%heading to be Sans Serif bold, and adjusts the spacing that follows the heading.
\newcommand{\entrylabel}[1]{
   {\parbox[b]{\labelwidth-4pt}{\makebox[0pt][l]{\small\sf\textbf{#1}}\vspace{1.5\baselineskip}}}} %was \vspace(1.5)

%LB 01/10/12. New command created to control spacing below the 'Data Fields' heading before the table. Used in the
%DoxyFields environment only.
\newcommand{\entrylabeldatafields}[1]{
   {\parbox[b]{\labelwidth-4pt}{\makebox[0pt][l]{\small\sf\textbf{#1}}\vspace{2.0\baselineskip}}}} %was \vspace(1.5)

%LB & JG 09/07/11. New command to support formatting inside the DoxyParagraph environment only with or without a heading.
\newcommand{\entrylabelpar}[1]{
   {\parbox[b]{\labelwidth-4pt}{\makebox[0pt][l]{\sf\small\textbf{#1}} \ifthenelse{\equal{#1}{}}{\vspace{\baselineskip}}{\vspace{1.5\baselineskip}}
}}} %Controls heading format and space below the heading. If there is no heading, the space below the heading will be the standard leading defined by \baselineskip. If there is a heading, the space below the heading will be 1.5 times \baselineskip. FYI: The \baselineskip command is the parameter LaTeX uses for defining the leading (normal vertical distance) between consecutive baselines. Standard LaTeX defines a leading approximately 20% larger than the design size of the font.

