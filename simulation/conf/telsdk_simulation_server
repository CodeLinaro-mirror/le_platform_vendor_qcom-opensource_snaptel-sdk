#!/bin/bash

start() {
    telsdk_simulation_server &
}


stop() {
    kill -15 $(pidof telsdk_simulation_server)
}

case "$1" in
    start)
       start
       ;;
    stop)
       stop
       ;;
    restart)
       stop
       start
       ;;
    status)
       pid=$(pidof telsdk_simulation_server)
       if [ "$pid" == "" ]
       then
           echo "Simulation server is not running"
       else
           echo "Simulation server is running with pid $pid"
       fi
       ;;
    *)
       echo "Usage: $0 {start|stop|status|restart}"
esac

exit 0
